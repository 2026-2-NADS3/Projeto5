# Copie para .env e ajuste. Nunca coloque segredos aqui: tudo que começa
# com VITE_ vai parar no código que roda no navegador.

# Supabase (Project Settings > API).
# Project URL, sem barra no final.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PÚBLICA: publishable ("sb_publishable_...") ou anon ("eyJ...").
# Nunca a secret/service_role, que ignora as regras de segurança (RLS).
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-publishable

# Tipo de rota: browser (padrão, produção), hash ou memory (só para prévias/links de demonstração).
VITE_ROUTER=browser
