<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo com cantos arredondados, usado nos botões principais (ex: Cadastrar).
     A cor real é definida por android:backgroundTint no próprio Button,
     então este drawable só cuida do formato. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/roxo" />
    <corners android:radius="28dp" />
</shape>
