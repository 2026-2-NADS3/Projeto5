# =============================================================================
#  .env.example - modelo de configuracao do projeto
# -----------------------------------------------------------------------------
#  COMO USAR
#      cp .env.example .env
#      (depois edite o .env e troque a senha)
#
#  O arquivo .env NAO vai para o Git (ver .gitignore). Este .env.example vai,
#  justamente para documentar quais variaveis existem sem expor os valores.
#
#  O docker-compose.yml le este arquivo automaticamente e injeta as variaveis
#  nos containers. Nenhuma credencial aparece no codigo nem nos Dockerfiles.
# =============================================================================

# -----------------------------------------------------------------------------
#  BANCO DE DADOS
# -----------------------------------------------------------------------------
#  Na primeira subida, a imagem do Postgres cria o banco e o usuario com estes
#  valores. Mudar DB_SENHA depois NAO altera a senha do banco ja' criado - e'
#  preciso recriar o volume (docker compose down -v).
DB_NOME=proximaetapa
DB_USUARIO=pe_app
DB_SENHA=troque_esta_senha_antes_de_entregar

# -----------------------------------------------------------------------------
#  PORTAS PUBLICADAS NO HOST
# -----------------------------------------------------------------------------
#  Se alguma destas portas ja' estiver em uso na sua maquina, troque o numero
#  aqui - nao e' preciso mexer no docker-compose.yml.
PORTA_WEB=8080           # painel administrativo: http://localhost:8080
PORTA_API_HOST=3000      # API direta (para testes com curl): localhost:3000
PORTA_API=3000           # porta interna em que o Node escuta

# -----------------------------------------------------------------------------
#  SERVICO DE BACKUP
# -----------------------------------------------------------------------------
MAX_COPIAS=5             # quantos pacotes .tar.gz manter (rotacao)
PREFIXO=proximaetapa     # prefixo do nome dos pacotes

#  Agenda no formato cron: minuto hora dia mes dia-da-semana
#    0 3 * * *     -> todos os dias as 03:00 (padrao)
#    */5 * * * *   -> a cada 5 minutos (util para DEMONSTRAR na apresentacao)
#    0 */6 * * *   -> a cada 6 horas
CRON_AGENDA=0 3 * * *

#  true = roda um backup imediatamente quando o container sobe.
#  Deixe true para a avaliacao: evita esperar o horario agendado.
BACKUP_AO_SUBIR=true

# -----------------------------------------------------------------------------
#  GERAL
# -----------------------------------------------------------------------------
TZ=America/Sao_Paulo
