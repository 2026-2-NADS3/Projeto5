<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pe_fundo"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/pe_margem_auth"
        android:paddingEnd="@dimen/pe_margem_auth"
        android:paddingBottom="32dp">

        <include
            android:id="@+id/logo"
            layout="@layout/view_logo"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="@dimen/pe_auth_logo_topo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txt_titulo"
            style="@style/TextAppearance.PE.TituloAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:accessibilityHeading="true"
            android:text="@string/nova_senha_titulo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo" />

        <EditText
            android:id="@+id/edt_senha"
            style="@style/Widget.PE.Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:autofillHints="newPassword"
            android:hint="@string/campo_senha"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:paddingEnd="52dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_titulo" />

        <ImageButton
            android:id="@+id/btn_olho_senha"
            style="@style/Widget.PE.BotaoOlho"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@id/edt_senha"
            app:layout_constraintEnd_toEndOf="@id/edt_senha"
            app:layout_constraintTop_toTopOf="@id/edt_senha"
            app:tint="@color/white" />

        <EditText
            android:id="@+id/edt_confirmacao"
            style="@style/Widget.PE.Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:autofillHints="newPassword"
            android:hint="@string/campo_confirmacao"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:paddingEnd="52dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edt_senha" />

        <ImageButton
            android:id="@+id/btn_olho_confirmacao"
            style="@style/Widget.PE.BotaoOlho"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@id/edt_confirmacao"
            app:layout_constraintEnd_toEndOf="@id/edt_confirmacao"
            app:layout_constraintTop_toTopOf="@id/edt_confirmacao"
            app:tint="@color/white" />

        <Button
            android:id="@+id/btn_salvar"
            style="@style/Widget.PE.Button.Principal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/btn_salvar_senha"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edt_confirmacao" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progresso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_salvar"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
