<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pe_fundo">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btn_salvar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/txt_onboarding"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lembrete"
                android:padding="12dp"
                android:text="@string/onboarding_msg"
                android:textColor="@color/pe_ink"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/txt_titulo_interesses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:text="@string/seus_interesses"
                android:textAppearance="@style/TextAppearance.PE.Secao"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txt_onboarding"
                app:layout_goneMarginTop="0dp" />

            <TextView
                android:id="@+id/txt_dica_interesses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/seus_interesses_dica"
                android:textAppearance="@style/TextAppearance.PE.Legenda"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txt_titulo_interesses" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_interesses"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txt_dica_interesses" />

            <TextView
                android:id="@+id/txt_titulo_dados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/dados_pessoais"
                android:textAppearance="@style/TextAppearance.PE.Secao"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chips_interesses" />

            <TextView
                android:id="@+id/rotulo_nome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@id/edt_nome"
                android:text="@string/campo_nome"
                android:textAppearance="@style/TextAppearance.PE.Rotulo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txt_titulo_dados" />

            <EditText
                android:id="@+id/edt_nome"
                style="@style/Widget.PE.Campo.Claro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="name"
                android:hint="@string/hint_nome"
                android:inputType="textPersonName|textCapWords"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rotulo_nome" />

            <TextView
                android:id="@+id/rotulo_linkedin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/edt_linkedin"
                android:text="@string/campo_linkedin"
                android:textAppearance="@style/TextAppearance.PE.Rotulo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edt_nome" />

            <EditText
                android:id="@+id/edt_linkedin"
                style="@style/Widget.PE.Campo.Claro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:hint="@string/hint_linkedin"
                android:inputType="textUri"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rotulo_linkedin" />

            <TextView
                android:id="@+id/txt_dica_demograficos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dados_demograficos_dica"
                android:textAppearance="@style/TextAppearance.PE.Legenda"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edt_linkedin" />

            <TextView
                android:id="@+id/rotulo_endereco"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:labelFor="@id/edt_endereco"
                android:text="@string/rotulo_endereco"
                android:textAppearance="@style/TextAppearance.PE.Rotulo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txt_dica_demograficos" />

            <EditText
                android:id="@+id/edt_endereco"
                style="@style/Widget.PE.Campo.Claro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="postalAddress"
                android:hint="@string/hint_opcional"
                android:inputType="textPostalAddress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rotulo_endereco" />

            <TextView
                android:id="@+id/rotulo_cidade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/edt_cidade"
                android:text="@string/rotulo_cidade"
                android:textAppearance="@style/TextAppearance.PE.Rotulo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edt_endereco" />

            <EditText
                android:id="@+id/edt_cidade"
                style="@style/Widget.PE.Campo.Claro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:hint="@string/hint_opcional"
                android:inputType="textCapWords"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rotulo_cidade" />

            <TextView
                android:id="@+id/rotulo_escola"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/edt_escola"
                android:text="@string/rotulo_escola"
                android:textAppearance="@style/TextAppearance.PE.Rotulo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edt_cidade" />

            <EditText
                android:id="@+id/edt_escola"
                style="@style/Widget.PE.Campo.Claro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:hint="@string/hint_opcional"
                android:inputType="textCapWords"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rotulo_escola" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btn_salvar"
        style="@style/Widget.PE.Button.Principal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/salvar"
        app:layout_constraintBottom_toTopOf="@id/btn_pular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="16dp" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progresso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="28dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_salvar"
        app:layout_constraintEnd_toEndOf="@id/btn_salvar"
        app:layout_constraintTop_toTopOf="@id/btn_salvar"
        android:layout_marginEnd="16dp"
        tools:visibility="visible" />

    <Button
        android:id="@+id/btn_pular"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/pular_por_enquanto"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
