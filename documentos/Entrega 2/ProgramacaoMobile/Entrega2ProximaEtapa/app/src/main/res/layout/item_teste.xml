<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/img_icone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icone_teste_azul"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:src="@drawable/ic_pessoa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/pe_ink" />

        <TextView
            android:id="@+id/txt_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textAppearance="@style/TextAppearance.PE.CardTitulo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_icone"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Perfil Comportamental" />

        <TextView
            android:id="@+id/txt_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PE.Legenda"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/txt_titulo"
            app:layout_constraintTop_toBottomOf="@id/txt_titulo"
            tools:text="Análise DISC · ~10 minutos" />

        <TextView
            android:id="@+id/txt_resultado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/pe_verde_texto"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/txt_titulo"
            app:layout_constraintTop_toBottomOf="@id/txt_sub"
            tools:text="Seu resultado: Influente"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_iniciar"
            style="@style/Widget.PE.Button.Verde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/iniciar_teste"
            app:layout_constraintStart_toStartOf="@id/txt_titulo"
            app:layout_constraintTop_toBottomOf="@id/txt_resultado" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resultado"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/ver_resultado"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btn_iniciar"
            app:layout_constraintStart_toEndOf="@id/btn_iniciar"
            app:layout_constraintTop_toTopOf="@id/btn_iniciar"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
