<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="76dp">

    <View
        android:id="@+id/divisor"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/pe_borda"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/coluna_dia"
        android:layout_width="52dp"
        android:layout_height="58dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divisor" />

    <TextView
        android:id="@+id/txt_dia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/pe_texto"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@id/txt_dia_semana"
        app:layout_constraintEnd_toEndOf="@id/coluna_dia"
        app:layout_constraintStart_toStartOf="@id/coluna_dia"
        app:layout_constraintTop_toTopOf="@id/coluna_dia"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="5" />

    <TextView
        android:id="@+id/txt_dia_semana"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.PE.Legenda"
        app:layout_constraintBottom_toBottomOf="@id/coluna_dia"
        app:layout_constraintEnd_toEndOf="@id/coluna_dia"
        app:layout_constraintStart_toStartOf="@id/coluna_dia"
        app:layout_constraintTop_toBottomOf="@id/txt_dia"
        tools:text="qua" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_eventos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:orientation="horizontal"
        android:paddingEnd="12dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/coluna_dia"
        app:layout_constraintTop_toBottomOf="@id/divisor"
        app:layout_constraintVertical_bias="0"
        tools:listitem="@layout/item_evento_agenda" />
</androidx.constraintlayout.widget.ConstraintLayout>
