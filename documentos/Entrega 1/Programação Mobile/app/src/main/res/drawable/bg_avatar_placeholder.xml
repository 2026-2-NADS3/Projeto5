<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo simples (retângulo com borda) usado como moldura da foto de perfil,
     no lugar da foto real do aluno (que virá de uma fonte de dados na Entrega 2). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/creme" />
    <stroke
        android:width="2dp"
        android:color="@color/preto" />
</shape>
