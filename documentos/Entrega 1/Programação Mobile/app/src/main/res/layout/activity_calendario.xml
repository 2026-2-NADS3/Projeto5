<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme"
    tools:context=".CalendarioActivity">

    <TextView
        android:id="@+id/txtTituloAgenda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:text="Agenda"
        android:textColor="@color/preto"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Navegação entre meses: as setas trocam o texto do mês (array + índice) -->
    <LinearLayout
        android:id="@+id/linhaMes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/creme"
        android:gravity="center_vertical"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloAgenda">

        <Button
            android:id="@+id/btnMesAnterior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/roxo"
            android:text="&lt;"
            android:textColor="@color/creme" />

        <TextView
            android:id="@+id/txtMes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Setembro"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="2026"
            android:textColor="@color/preto" />

        <Button
            android:id="@+id/btnProximoMes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/roxo"
            android:text="&gt;"
            android:textColor="@color/creme" />

    </LinearLayout>

    <!-- Cabeçalho dos dias da semana -->
    <LinearLayout
        android:id="@+id/linhaCabecalhoDias"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linhaMes">

        <TextView style="@style/DiaSemanaHeader" android:text="D" />
        <TextView style="@style/DiaSemanaHeader" android:text="S" />
        <TextView style="@style/DiaSemanaHeader" android:text="T" />
        <TextView style="@style/DiaSemanaHeader" android:text="Q" />
        <TextView style="@style/DiaSemanaHeader" android:text="Q" />
        <TextView style="@style/DiaSemanaHeader" android:text="S" />
        <TextView style="@style/DiaSemanaHeader" android:text="S" />
    </LinearLayout>

    <!-- Grade de dias do mês (estática nesta etapa: mostra Setembro/2026) -->
    <LinearLayout
        android:id="@+id/gradeCalendario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linhaCabecalhoDias">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/DiaCalendario" android:text="" />
            <TextView style="@style/DiaCalendario" android:text="" />
            <TextView style="@style/DiaCalendario" android:text="1" />
            <TextView style="@style/DiaCalendario" android:text="2" />
            <TextView style="@style/DiaCalendario" android:text="3" />
            <TextView style="@style/DiaCalendario" android:text="4" />
            <TextView style="@style/DiaCalendario" android:text="5" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/DiaCalendario" android:text="6" />
            <TextView style="@style/DiaCalendario" android:text="7" />
            <TextView style="@style/DiaCalendario" android:text="8" />
            <TextView style="@style/DiaCalendario" android:text="9" />
            <TextView style="@style/DiaCalendario" android:text="10" />
            <TextView style="@style/DiaCalendario" android:text="11" />
            <TextView style="@style/DiaCalendario" android:text="12" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/DiaCalendario" android:text="13" />
            <!-- Dia 14: destacado, representa o evento exibido abaixo -->
            <TextView
                android:id="@+id/txtDiaSelecionado"
                style="@style/DiaCalendario"
                android:background="@drawable/bg_dia_selecionado"
                android:text="14"
                android:textColor="@color/preto"
                android:textStyle="bold" />
            <TextView style="@style/DiaCalendario" android:text="15" />
            <TextView style="@style/DiaCalendario" android:text="16" />
            <TextView style="@style/DiaCalendario" android:text="17" />
            <TextView style="@style/DiaCalendario" android:text="18" />
            <TextView style="@style/DiaCalendario" android:text="19" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/DiaCalendario" android:text="20" />
            <TextView style="@style/DiaCalendario" android:text="21" />
            <TextView style="@style/DiaCalendario" android:text="22" />
            <TextView style="@style/DiaCalendario" android:text="23" />
            <TextView style="@style/DiaCalendario" android:text="24" />
            <TextView style="@style/DiaCalendario" android:text="25" />
            <TextView style="@style/DiaCalendario" android:text="26" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView style="@style/DiaCalendario" android:text="27" />
            <TextView style="@style/DiaCalendario" android:text="28" />
            <TextView style="@style/DiaCalendario" android:text="29" />
            <TextView style="@style/DiaCalendario" android:text="30" />
            <TextView style="@style/DiaCalendario" android:text="" />
            <TextView style="@style/DiaCalendario" android:text="" />
            <TextView style="@style/DiaCalendario" android:text="" />
        </LinearLayout>

    </LinearLayout>

    <!-- Cartão do evento do dia selecionado. Os textos são preenchidos via-->
    <LinearLayout
        android:id="@+id/cartaoEvento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/creme"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gradeCalendario">

        <TextView
            android:id="@+id/txtTema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TEMA: "
            android:textColor="@color/preto"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="HORÁRIO: "
            android:textColor="@color/preto"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="LOCAL: "
            android:textColor="@color/preto"
            android:textStyle="bold" />

        <!-- dado numérico (carga horária calculada na classe evento) -->
        <TextView
            android:id="@+id/txtCargaHoraria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="CARGA HORÁRIA: "
            android:textColor="@color/roxo"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- barra de navegação inferior (mesma estrutura da tela de Perfil) -->
    <LinearLayout
        android:id="@+id/barraNavegacaoInferior"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/amarelo"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnNavInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/amareloClaro"
            android:contentDescription="Início (Entrega 2)"
            android:src="@drawable/nav_generico" />

        <ImageButton
            android:id="@+id/btnNavMensagens"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/amareloClaro"
            android:contentDescription="Mensagens (Entrega 2)"
            android:src="@drawable/nav_generico" />

        <ImageButton
            android:id="@+id/btnNavCalendario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/amarelo"
            android:contentDescription="Calendário (tela atual)"
            android:src="@drawable/nav_calendario" />

        <ImageButton
            android:id="@+id/btnNavPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/amareloClaro"
            android:contentDescription="Ir para o Perfil"
            android:src="@drawable/nav_perfil" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
